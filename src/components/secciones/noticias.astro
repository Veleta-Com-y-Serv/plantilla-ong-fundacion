---
// Noticias: tres columnas a todo el ancho con foto (esquina «de casa»), categoría en naranja, fecha y título serif.
// Cada noticia: `noticias[]` {fecha, categoria, titulo, texto, imagen, url opcional}. Sin noticias no se pinta.
import { seccion, externo } from '../../data/site';
import { altFicha } from '../../lib/seo';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const noticias = (s?.noticias ?? []).filter((n) => n && n.titulo);
const destino = (u?: string) => (u ? { href: u, ...(externo(u) ? { rel: 'noopener', target: '_blank' } : {}) } : null);
---

{
  s && noticias.length > 0 && (
    <Seccion id={Astro.props.id}>
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} />
        {s.texto && <p class="max-w-md text-lg opacity-85 lg:text-right">{s.texto}</p>}
      </div>
      <ul class="mt-12 grid gap-x-8 gap-y-14 md:mt-16 md:grid-cols-2 lg:grid-cols-3">
        {noticias.map((n) => {
          const d = destino(n.url);
          return (
            <li class="noticia flex flex-col">
              {n.imagen && <Imagen src={n.imagen} alt={altFicha(n)} ancho={900} alto={675} class="aspect-[4/3] w-full rounded-tr-[3.5rem] object-cover" />}
              <p class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
                {n.categoria && <span class="rounded-full bg-[var(--c-arena)] px-3 py-1 font-bold uppercase tracking-[.12em] text-[var(--c-sobre-acento)]">{n.categoria}</span>}
                {n.fecha && <time class="opacity-70">{n.fecha}</time>}
              </p>
              <h3 class="mt-3 text-[1.65rem] leading-tight">
                {d ? <a {...d} class="hover:underline hover:decoration-acento hover:decoration-2 hover:underline-offset-4">{n.titulo}</a> : n.titulo}
              </h3>
              {n.texto && <p class="mt-3 opacity-80">{n.texto}</p>}
            </li>
          );
        })}
      </ul>
    </Seccion>
  )
}
